{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "LLM Provider",
            "expanded": true,
            "items": [
                {
                    "type": "Select",
                    "name": "Provider",
                    "caption": "Provider",
                    "options": [
                        {"caption": "LM Studio (local, OpenAI-compatible)", "value": "lmstudio"},
                        {"caption": "Anthropic Claude API", "value": "claude"}
                    ]
                },
                {"type": "ValidationTextBox", "name": "Endpoint", "caption": "Endpoint (LM Studio / OpenAI-compatible)"},
                {"type": "PasswordTextBox", "name": "ApiKey", "caption": "API Key"},
                {"type": "ValidationTextBox", "name": "Model", "caption": "Model (must support native tool calling)"},
                {"type": "NumberSpinner", "name": "Temperature", "caption": "Temperature", "digits": 2, "minimum": 0, "maximum": 2},
                {"type": "NumberSpinner", "name": "MaxTokens", "caption": "Max tokens", "minimum": 64, "maximum": 65536}
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Chat Behavior",
            "items": [
                {
                    "type": "Select",
                    "name": "Language",
                    "caption": "Language",
                    "options": [
                        {"caption": "Deutsch", "value": "de"},
                        {"caption": "English", "value": "en"}
                    ]
                },
                {"type": "ValidationTextBox", "name": "Actor", "caption": "Actor name (for audit)"},
                {
                    "type": "Select",
                    "name": "Scope",
                    "caption": "Scope",
                    "options": [
                        {"caption": "read_only", "value": "read_only"},
                        {"caption": "control", "value": "control"},
                        {"caption": "automation", "value": "automation"},
                        {"caption": "full", "value": "full"}
                    ]
                },
                {"type": "ValidationTextBox", "multiline": true, "name": "SystemPromptOverride", "caption": "System prompt (override)"},
                {"type": "ValidationTextBox", "name": "AllowedRoots", "caption": "Allowed root IDs (JSON array)"},
                {"type": "NumberSpinner", "name": "HistoryLimit", "caption": "History limit (messages)", "minimum": 2, "maximum": 500}
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Embeddings",
            "items": [
                {"type": "ValidationTextBox", "name": "EmbedModel", "caption": "Embedding model"},
                {"type": "Button", "caption": "Rebuild index", "onClick": "echo AICHAT_RebuildIndex($id);"}
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Budgets",
            "items": [
                {"type": "NumberSpinner", "name": "MaxToolCalls", "caption": "Max tool calls per turn", "minimum": 1, "maximum": 200},
                {"type": "NumberSpinner", "name": "MaxIterations", "caption": "Max LLM iterations", "minimum": 0, "maximum": 200},
                {"type": "NumberSpinner", "name": "TimeoutSec", "caption": "Timeout per LLM call (s)", "minimum": 5, "maximum": 600}
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Safety & Audit",
            "items": [
                {"type": "CheckBox", "name": "DryRun", "caption": "Dry-run"},
                {"type": "CheckBox", "name": "ExposeSecrets", "caption": "Expose redacted instance secrets (scope=full only)"},
                {
                    "type": "Select",
                    "name": "AuditVerbosity",
                    "caption": "Audit verbosity",
                    "options": [
                        {"caption": "Minimal", "value": "minimal"},
                        {"caption": "Normal", "value": "normal"},
                        {"caption": "Verbose", "value": "verbose"}
                    ]
                },
                {"type": "ValidationTextBox", "name": "AuditLogFile", "caption": "Audit log file"}
            ]
        }
    ],
    "actions": [
        {"type": "Button", "caption": "Test connection", "onClick": "echo AICHAT_TestConnection($id);"},
        {"type": "Button", "caption": "Reset history", "onClick": "AICHAT_ResetHistory($id);"}
    ]
}
